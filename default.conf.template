server {
    # Listen on both ports so Railway's edge routing can hit nginx no
    # matter which port the service's UI is configured to forward.
    # (The Railway subdomain maps to 80, the custom domain maps to 3000.)
    listen       80      default_server;
    listen       [::]:80 default_server;
    listen       3000;
    listen       [::]:3000;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    # Long-cache static art + fonts — these don't change between deploys
    location ~* \.(?:riv|png|jpg|jpeg|svg|webp|gif|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }
}
